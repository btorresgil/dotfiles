#!/bin/zsh
# Non-symlink bootstrap: stow install, Brewfile, macOS defaults, missing programs.
# Symlinking lives in the Makefile (`make apply`).

set -e

DOTFILES="$HOME/.dotfiles"

# 1. Ensure homebrew is installed
if ! command -v brew >/dev/null 2>&1; then
  echo "==> brew not found; installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  echo "==> Homebrew installed."
fi

# 2. Ensure stow is installed
if ! command -v stow >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    echo "==> stow not found; installing via Homebrew..."
    brew install stow
    echo "==> stow installed."
  else
    echo "stow not installed and Homebrew not available; install stow first" >&2
    exit 1
  fi
fi

# 3. Install the OS-specific Brewfile. Brewfile-macos-full is manual-only.
if command -v brew >/dev/null 2>&1; then
  case "$(uname)" in
  Darwin)
    BREWFILE="$DOTFILES/Brewfile-macos-minimal"
    ;;
  Linux)
    BREWFILE="$DOTFILES/Brewfile-linux"
    ;;
  *)
    BREWFILE=""
    ;;
  esac

  if [ -n "$BREWFILE" ] && [ -f "$BREWFILE" ]; then
    if ! brew bundle check --file="$BREWFILE" >/dev/null 2>&1; then
      brew bundle install --file="$BREWFILE"
    fi
  fi
fi

# 4. iTerm2 prefs directory — point iTerm at the in-repo location.
# The plist lives in packages/iterm2/.config/iterm2/ and is loaded by iTerm
# directly (not stowed into $HOME, since iTerm reads from an arbitrary path
# configured via `defaults`).
if [ "$(uname)" = "Darwin" ]; then
  ITERM_DIR="$DOTFILES/iterm2"
  if [ -d "$ITERM_DIR" ]; then
    defaults write com.googlecode.iterm2.plist PrefsCustomFolder -string "$ITERM_DIR"
    defaults write com.googlecode.iterm2.plist LoadPrefsFromCustomFolder -bool true
  fi
fi

# 5. Create symlinks with stow
echo "Using stow to create symlinks."
cd ${DOTFILES} && stow -R .
cd ${DOTFILES} && stow -t ${HOME} -R home

# 6. Install tmux plugin manager and plugins
TPM_DIR="$HOME/.tmux/plugins/tpm"
if command -v tmux >/dev/null 2>&1 && command -v git >/dev/null 2>&1; then
  if [ ! -d "$TPM_DIR/.git" ]; then
    echo "==> Installing tmux plugin manager..."
    mkdir -p "$(dirname "$TPM_DIR")"
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
  fi

  echo "==> Installing tmux plugins..."
  tmux start-server
  tmux source-file "$HOME/.config/tmux/tmux.conf"
  "$TPM_DIR/bin/install_plugins"
else
  echo "tmux or git not available; skipping tmux plugin install" >&2
fi

echo "dotfiles bootstrap completed!"
